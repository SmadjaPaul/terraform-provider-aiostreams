{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs"
  ],
  "dependencyDashboard": true,
  "updateInternalDeps": true,
  "automerge": false,
  "platformAutomerge": false,
  "timezone": "Europe/Paris",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Terraform plugin framework and Go dependencies require race tests and vet before merge.",
      "matchManagers": [
        "gomod"
      ],
      "automerge": false
    },
    {
      "description": "Workflow actions remain manually qualified until SHA-pinning and CI gate are established.",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "PLT-131 Go pilot discovery allow-list: only the two indirect test/output helpers are enabled.",
      "enabled": true,
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "go.mod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchPackageNames": [
        "github.com/fatih/color",
        "github.com/mitchellh/go-testing-interface"
      ]
    },
    {
      "description": "PLT-131 five stable indirect Go utilities patch-only; 14-day age, race/vet required",
      "groupName": "PLT-131 provider Go non-critical pilot",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "go.mod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchPackageNames": [
        "github.com/fatih/color",
        "github.com/mitchellh/go-testing-interface",
        "github.com/hashicorp/go-hclog",
        "github.com/hashicorp/go-uuid",
        "github.com/oklog/run"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "14 days",
      "automerge": true,
      "platformAutomerge": true,
      "automergeType": "pr"
    },
    {
      "description": "PLT-131 provider actions remain controlled: workflow changes need explicit qualification.",
      "enabled": true,
      "groupName": "PLT-131 provider CI actions controlled",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/*.yml"
      ],
      "matchPackageNames": [
        "actions/checkout",
        "actions/setup-go"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "minimumReleaseAge": "14 days",
      "automerge": false,
      "platformAutomerge": false
    }
  ]
}
